{
	"name": "@cosmonexus/monorepo",
	"private": true,
	"type": "module",
	"workspaces": ["packages/*", "apps/*"],
	"scripts": {
		"build": "moon run :build",
		"test": "moon run :test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "moon run :typecheck",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@moonrepo/cli": "2.5.1",
		"fast-check": "3.23.2",
		"tsdown": "0.22.14",
		"typescript": "5.7.3",
		"vitest": "2.1.8"
	}
}
