{
	"name": "@cosmonexus/design-tokens",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./contract": {
			"types": "./dist/contract.css.d.ts",
			"import": "./dist/contract.css.js",
			"require": "./dist/contract.css.cjs"
		},
		"./themes/dark": {
			"types": "./dist/themes/dark.css.d.ts",
			"import": "./dist/themes/dark.css.js",
			"require": "./dist/themes/dark.css.cjs"
		},
		"./themes/light": {
			"types": "./dist/themes/light.css.d.ts",
			"import": "./dist/themes/light.css.js",
			"require": "./dist/themes/light.css.cjs"
		},
		"./global": {
			"types": "./dist/global.css.d.ts",
			"import": "./dist/global.css.js",
			"require": "./dist/global.css.cjs"
		},
		"./css": "./dist/css/tokens.css",
		"./css/dark": "./dist/css/tokens.dark.css",
		"./css/light": "./dist/css/tokens.light.css"
	},
	"files": [
		"dist/**",
		"src/**"
	],
	"sideEffects": ["**/*.css", "./dist/global.css.js", "./dist/global.css.cjs"],
	"scripts": {
		"build": "bun run tokens:generate && tsup",
		"tokens:generate": "bun scripts/generate.ts",
		"test": "vitest run",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@vanilla-extract/css": "^1.15.0"
	},
	"devDependencies": {
		"@cosmonexus/tsconfig": "workspace:*",
		"@types/bun": "^1.1.14",
		"@vanilla-extract/css": "^1.15.0",
		"open-props": "^1.7.0",
		"style-dictionary": "^4.2.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
