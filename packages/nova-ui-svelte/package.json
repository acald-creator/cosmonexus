{
	"name": "@cosmonexus/nova-ui-svelte",
	"version": "0.1.3",
	"type": "module",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": ["dist"],
	"scripts": {
		"build": "rm -rf dist && vite build && mv dist/styles-runtime.css dist/styles.css && svelte-package -o dist/components && node scripts/assemble.mjs",
		"lint": "biome check .",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@cosmonexus/design-tokens": "workspace:*",
		"@vanilla-extract/css": "^1.15.0",
		"@vanilla-extract/recipes": "^0.5.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@cosmonexus/tsconfig": "workspace:*",
		"@sveltejs/package": "^2.3.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@vanilla-extract/vite-plugin": "^4.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"vite": "^6.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
